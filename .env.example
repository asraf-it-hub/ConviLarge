# Client
VITE_API_URL=http://localhost:5000/api

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=asrafpothuganti@gmail.com
MONGODB_URI=mongodb://127.0.0.1:27017/convilarge
REDIS_URL=redis://127.0.0.1:6379
MAX_FILE_SIZE_MB=250
FILE_TTL_HOURS=24
# PDF lock/unlock: install qpdf, then set this if qpdf is not on PATH.
# Source: https://qpdf.readthedocs.io/en/latest/installation.html
QPDF_PATH=qpdf

# Remove background: install rembg on the server.
# Source: https://pypi.org/project/rembg/
REMBG_COMMAND=rembg
