# Client
VITE_API_URL=http://localhost:5000/api

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=asrafpothuganti@gmail.com
MONGODB_URI=mongodb://127.0.0.1:27017/convilarge
REDIS_URL=redis://127.0.0.1:6379
MAX_FILE_SIZE_MB=250
FILE_TTL_HOURS=24
# PDF lock/unlock: install qpdf, then set this if qpdf is not on PATH.
# Source: https://qpdf.readthedocs.io/en/latest/installation.html
QPDF_PATH=qpdf
AI_ENABLED=true
AI_DEFAULT_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=gemini
AI_FREE_DAILY_TASKS=3
AI_AUTH_DAILY_TASKS=30
AI_MAX_FILE_MB=25
AI_MAX_TEXT_CHARS=120000
AI_STORE_HISTORY=true
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
OPENAI_REASONING_MODEL=gpt-5.4
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
OPENROUTER_MAX_TOKENS=2000
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
